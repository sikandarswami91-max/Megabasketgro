# Frontend Environment Configuration

# For local development with backend on port 5001:
VITE_API_URL=http://localhost:5001/api

# For production (Vercel), the root vercel.json rewrites "/api/*" to the Render
# backend, so the relative "/api" default works and VITE_API_URL is not needed.
# Setting it here overrides that rewrite with direct browser -> Render calls
# (requires the Render origin to be allowed by the backend CORS allow-list).
# VITE_API_URL=https://megabasketgro.onrender.com/api

# For same-origin production (frontend & backend on same domain),
# set this to /api or leave VITE_API_URL unset so the default relative path is used.
