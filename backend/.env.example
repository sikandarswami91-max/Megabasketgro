# Backend Configuration
PORT=5001
MONGODB_URI=mongodb://localhost:27017/megabasket
JWT_SECRET=change_this_to_a_random_long_string

# Cloudinary Image Storage (Optional)
# Cloudinary is used for uploading new product images via the admin panel.
# Existing product images use Unsplash URLs and do NOT require Cloudinary.
#
# To set up Cloudinary:
# 1. Create a free account at https://cloudinary.com
# 2. Go to Dashboard -> Copy your Cloud Name, API Key, and API Secret
# 3. Set these values below (or on Render dashboard)
#
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
#
# If not set, uploaded images will use base64 data URI fallback (suitable for development).

# Frontend CORS Configuration
# For local development (Vite dev server default port):
FRONTEND_URL=http://localhost:5173

# For production on Render, set this to your deployed Vercel frontend URL:
# FRONTEND_URL=https://megabasketgro.vercel.app